# Mini Operations ERP - backend environment variables
# Copy to backend/.env and replace every value. No value below is a working credential.

# --- Database (MySQL 8.0.16 or later) ------------------------------------------------
# Kept as separate variables rather than one connection URL, because that is the shape a
# managed MySQL host hands you: AWS RDS shows the endpoint, port, user and database name on
# separate fields, so a deployment copies them across without assembling a URL.
#
# 8.0.16 is the floor because the schema uses CHECK constraints, which earlier versions parse
# and then silently ignore.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace-with-a-mysql-user
# Required to be PRESENT, but may be empty for a local passwordless MySQL install.
MYSQL_PASSWORD=replace-with-that-user-password
MYSQL_DATABASE=mini_operations_erp

# The test suite does NOT use the database above. It creates, uses and drops
# "<MYSQL_DATABASE>_test" instead, so running `npm test` never touches your own data.
# The MYSQL_USER above therefore needs CREATE/DROP DATABASE rights to run the tests.

# --- API server ----------------------------------------------------------------------
# Required. Secret used to sign and verify JSON Web Tokens. Must be at least 32 characters.
JWT_SECRET=replace-with-a-random-string-of-32-plus-chars

# Required. Port the API server binds. Decimal integer between 1 and 65535.
PORT=4000

# Required. The single browser origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# --- Seed script only ----------------------------------------------------------------
# Read by scripts/seed.js, never by the API server. Each must be non-blank and at most 72
# characters (bcrypt ignores anything beyond 72 bytes). scripts/seed.js exits non-zero and
# names every missing one, so no password value is ever written into a tracked file.
#   SEED_ADMIN_PASSWORD -> admin@mini-erp.local        (Admin)
#   SEED_OPS_PASSWORD   -> operations@mini-erp.local   (OperationsUser)
#   SEED_SALES_PASSWORD -> sales@mini-erp.local        (SalesUser)
SEED_ADMIN_PASSWORD=change-me-admin
SEED_OPS_PASSWORD=change-me-operations
SEED_SALES_PASSWORD=change-me-sales
