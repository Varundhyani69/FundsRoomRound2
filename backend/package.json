{
    "name": "mini-operations-erp-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Mini Operations ERP backend: Express + Mongoose API for inventory, work orders, internal transfers and customer orders",
    "main": "src/server.js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "test": "jest --runInBand",
        "seed": "node scripts/seed.js"
    },
    "dependencies": {
        "bcryptjs": "2.4.3",
        "cors": "2.8.5",
        "dotenv": "16.4.7",
        "express": "4.21.2",
        "jsonwebtoken": "9.0.2",
        "mongoose": "8.9.5",
        "zod": "3.24.1"
    },
    "devDependencies": {
        "fast-check": "3.23.2",
        "jest": "29.7.0",
        "mongodb-memory-server": "10.1.4",
        "supertest": "7.0.0"
    }
}