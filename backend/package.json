{
    "name": "mini-operations-erp-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Mini Operations ERP backend: Express + MySQL (raw SQL via mysql2) API for inventory, work orders, internal transfers and customer orders",
    "main": "src/server.js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "test": "jest --runInBand",
        "migrate": "node scripts/migrate.js",
        "seed": "node scripts/seed.js",
        "postman": "node scripts/postman.js"
    },
    "dependencies": {
        "bcryptjs": "2.4.3",
        "cors": "2.8.5",
        "dotenv": "16.4.7",
        "express": "4.21.2",
        "jsonwebtoken": "9.0.2",
        "mysql2": "3.11.5",
        "zod": "3.24.1"
    },
    "devDependencies": {
        "fast-check": "3.23.2",
        "jest": "29.7.0",
        "supertest": "7.0.0"
    }
}
