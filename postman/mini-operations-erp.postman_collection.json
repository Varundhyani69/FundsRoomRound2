                        "description": "**Permitted roles:** `Admin`, `OperationsUser`.\n\nWrites the record and its opening ledger row in one transaction (Req 4.4).",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"item\": \"6a8a5bff3cc5768dea0724a4\",\n    \"location\": \"6a8a5bff3cc5768dea0724a4\",\n    \"batch\": \"BATCH-001\",\n    \"physicalQuantity\": 50,\n    \"movementReference\": \"opening-2026-08-23-001\"\n}\n",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Read total available quantity of an item at a location",
                    "request": {
                        "method": "GET",
                        "header": [
