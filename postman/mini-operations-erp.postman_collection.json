                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/:id/adjust",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                ":id",
                                "adjust"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "",
                                    "description": "A 24-character hexadecimal identifier."
                                }
                            ]
                        },
                        "description": "**Permitted roles:** `Admin`, `OperationsUser`.\n\nRejected when the movement would drive physical below 0 or reserved above physical (Req 3.8, 3.9).",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"direction\": \"IN\",\n    \"quantity\": 20,\n    \"movementReference\": \"adjust-2026-08-23-001\"\n}\n",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
