                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/inventory/availability?item=&location=",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "inventory",
                                "availability"
                            ],
                            "query": [
                                {
                                    "key": "item",
                                    "value": "",
                                    "description": ""
                                },
                                {
                                    "key": "location",
                                    "value": "",
                                    "description": ""
                                }
                            ]
                        },
                        "description": "**Permitted roles:** any authenticated role.\n\nBoth query parameters are required."
                    }
                },
