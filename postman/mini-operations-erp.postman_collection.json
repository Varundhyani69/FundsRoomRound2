{
    "info": {
        "name": "Mini Operations ERP API v1.0.0",
        "description": "Operations ERP covering Inventory → Work Order → Stock Check →\nInternal Transfer / Shortage → Customer Reservation.\n\nEvery route except `POST /api/auth/login` requires a Bearer JWT.\nReads are permitted for any authenticated role; writes are restricted\nby the role table in `src/permissions.js`, enforced server-side.\n\n---\n\nGenerated by `backend/scripts/postman.js` from `backend/src/openapi.js`.\nDo not edit by hand -- run `npm run postman` in `backend/` instead.\n\nSend the login request first: its test script stores the JWT in the\n`token` collection variable, which every other request sends as\n`Authorization: Bearer {{token}}`. Point `baseUrl` at another instance\nby editing the collection variable or selecting an environment.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "auth",
            "item": [
                {
                    "name": "Exchange credentials for a JWT",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "**Permitted roles:** public — no token required.\n\nAn unmatched email and a wrong password return an identical response, so email existence cannot be probed (Req 1.4).",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@mini-erp.local\",\n    \"password\": \"your-seed-password\"\n}\n",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Captures the JWT so every other request in this collection is authenticated.",
                                    "// Runs automatically after this request; no copy-paste needed.",
                                    "const body = pm.response.json();",
                                    "",
                                    "pm.test('login returns a token', function () {",
                                    "    pm.expect(pm.response.code).to.eql(200);",
                                    "    pm.expect(body).to.have.property('token');",
                                    "});",
                                    "",
                                    "if (body && body.token) {",
                                    "    pm.collectionVariables.set('token', body.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
