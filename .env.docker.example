# .env.docker.example -- Compose configuration. Copy to .env.docker and fill in.
#
#   cp .env.docker.example .env.docker
#
# .env.docker is gitignored. No value below is a working credential.
#
# This is for `docker compose` on your own machine. On AWS these same names are set
# on the ECS task definition instead, with the two secrets coming from Secrets
# Manager rather than from a file -- see DEPLOYMENT.md.

# --- MySQL ------------------------------------------------------------------------
# MYSQL_HOST and MYSQL_PORT are deliberately absent: docker-compose.yml overrides
# them to the `mysql` service name, because 127.0.0.1 inside a container is the
# container itself, not your host.

# Used both as the MySQL root password and as the password the API connects with.
# Fine for a local stack; on AWS the app gets its own least-privilege user instead
# of the master user.
MYSQL_PASSWORD=replace-with-a-local-password

MYSQL_USER=root
MYSQL_DATABASE=mini_operations_erp

# --- API server -------------------------------------------------------------------
# At least 32 characters. Generate a real one rather than typing something:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters

PORT=4000

# The single browser origin the API's CORS policy allows. Must match where the SPA is
# actually served from -- 5173 is the port docker-compose.yml publishes the frontend
# on. A mismatch here shows up as the login request failing in the browser while
# working perfectly from curl, because curl does not enforce CORS.
CORS_ORIGIN=http://localhost:5173

# --- Web_Client (build-time) -------------------------------------------------------
# BUILD-time, not runtime: Vite bakes this into the bundle, so changing it needs
# `docker compose build frontend`. Must be the URL the BROWSER can reach -- your
# host's localhost, not the Compose service name.
VITE_API_BASE_URL=http://localhost:4000

# --- Seed script only -------------------------------------------------------------
# Read by `npm run seed`, never by the API server. Each at most 72 characters
# (bcrypt ignores anything beyond that, and the login schema rejects it).
SEED_ADMIN_PASSWORD=replace-with-admin-password
SEED_OPS_PASSWORD=replace-with-operations-password
SEED_SALES_PASSWORD=replace-with-sales-password
