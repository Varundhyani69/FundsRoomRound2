# Dependencies
node_modules/

# Environment files (secrets are read at run time, never tracked)
.env
.env.*
!.env.example
# The Compose template. Needed as its own exception because `.env.*` above matches
# `.env.docker.example` too, and only the literal `.env.example` is re-included.
!.env.docker.example

# Test and build output
coverage/
dist/

# Written by the jest globalSetup that creates the throwaway MySQL test database, so
# every worker can point src/config at it. Regenerated on every `npm test` run.
backend/tests/setup/.test-env.json

# Editor and OS noise
.DS_Store
.vscode/
*.log
