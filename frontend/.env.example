# frontend/.env.example -- copy to frontend/.env and fill in real values.
# Not a secret: documents the required build-time variable (Req 10.7, 10.8).

# API_Server base URL the Web_Client is built against. Required, must be an
# absolute URL with no trailing slash. The build fails fast if this is
# absent, empty, or whitespace-only (Req 10.11).
VITE_API_BASE_URL=http://localhost:4000
