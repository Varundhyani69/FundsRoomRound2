# frontend/.env.example -- copy to frontend/.env and fill in real values.
# Not a secret: documents the required build-time variable (Req 10.7, 10.8).

# API_Server base URL the Web_Client is built against. Required, must be an
# absolute URL with no trailing slash. The build fails fast if this is
# absent, empty, or whitespace-only (Req 10.11).
VITE_API_BASE_URL=http://localhost:4000

# --- Demo credentials panel (OPTIONAL) --------------------------------------------
# These three turn on the click-to-fill demo-account panel on the login screen
# (frontend/src/components/DemoCredentials.jsx). They are OPTIONAL: leave them unset
# and no panel renders at all, which is the default and what a plain
# `cp .env.example .env` gives you. The build succeeds either way -- unlike
# VITE_API_BASE_URL, these are not checked in vite.config.js.
#
# Build-time only, exactly like VITE_API_BASE_URL: Vite substitutes the values into
# the bundle, so changing them needs a rebuild, not a restart.
#
# Setting any of them bakes a WORKING password into the shipped JavaScript, readable
# by anyone who loads the page. They belong to a throwaway review deployment seeded
# with sample rows and nothing else -- leave them unset for anything holding real
# data.
#
# Each value must equal the SEED_* password used to seed that deployment's database,
# or the buttons will fill a password the server rejects with a 401. Set only the
# roles you want offered; the rest are omitted from the panel.
# VITE_DEMO_ADMIN_PASSWORD=set-to-the-same-value-as-SEED_ADMIN_PASSWORD
# VITE_DEMO_OPS_PASSWORD=set-to-the-same-value-as-SEED_OPS_PASSWORD
# VITE_DEMO_SALES_PASSWORD=set-to-the-same-value-as-SEED_SALES_PASSWORD
